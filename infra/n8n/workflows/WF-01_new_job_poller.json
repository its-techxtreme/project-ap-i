{
  "name": "WF-01 New Job Poller",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      },
      "id": "a1000001-0001-4000-8000-000000000001",
      "name": "Every 2 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WORKER_BASE_URL }}/jobs/claim",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "fullResponse": false,
              "neverError": false
            }
          }
        }
      },
      "id": "a1000001-0001-4000-8000-000000000002",
      "name": "Claim Next Job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300],
      "credentials": {
        "httpHeaderAuth": {
          "name": "WorkerToken"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "a1000001-0001-4000-8000-000000000010",
              "leftValue": "={{ $json.claimed }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000001-0001-4000-8000-000000000003",
      "name": "Job Claimed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1000001-0001-4000-8000-000000000011",
              "name": "jobId",
              "value": "={{ $json.job.id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000001-0001-4000-8000-000000000004",
      "name": "Prepare Job Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [960, 220]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "list",
          "value": "",
          "cachedResultName": "WF-02 Process Job"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "jobId": "={{ $json.jobId }}"
          }
        },
        "options": {}
      },
      "id": "a1000001-0001-4000-8000-000000000005",
      "name": "Run WF-02 Process Job",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [1200, 220]
    },
    {
      "parameters": {},
      "id": "a1000001-0001-4000-8000-000000000006",
      "name": "No Queued Jobs",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [960, 400]
    },
    {
      "parameters": {},
      "id": "a1000001-0001-4000-8000-000000000007",
      "name": "Claim Error",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [720, 520]
    }
  ],
  "connections": {
    "Every 2 Minutes": {
      "main": [
        [
          {
            "node": "Claim Next Job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim Next Job": {
      "main": [
        [
          {
            "node": "Job Claimed?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Claim Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Job Claimed?": {
      "main": [
        [
          {
            "node": "Prepare Job Payload",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Queued Jobs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Job Payload": {
      "main": [
        [
          {
            "node": "Run WF-02 Process Job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": false,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "staticData": null,
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "pinData": {},
  "tags": [
    {
      "name": "project-ap-i"
    }
  ]
}
