{
  "name": "WF-07 Admin Command Poller",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "a7000007-0007-4000-8000-000000000001",
      "name": "Every 1 Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WORKER_BASE_URL }}/admin-commands/process-next",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "fullResponse": false,
              "neverError": false
            }
          }
        }
      },
      "id": "a7000007-0007-4000-8000-000000000002",
      "name": "Process Next Admin Command",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "onError": "continueErrorOutput",
      "credentials": {
        "httpHeaderAuth": {
          "name": "WorkerToken"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "a7000007-0007-4000-8000-000000000010",
              "leftValue": "={{ $json.processed }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a7000007-0007-4000-8000-000000000003",
      "name": "Command Processed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a7000007-0007-4000-8000-000000000011",
              "name": "summary",
              "value": "={{ { commandId: $json.commandId, jobId: $json.jobId, command: $json.command, success: $json.success, error: $json.error } }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "id": "a7000007-0007-4000-8000-000000000004",
      "name": "Log Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        960,
        220
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a7000007-0007-4000-8000-000000000012",
              "name": "idle",
              "value": true,
              "type": "boolean"
            }
          ]
        },
        "options": {}
      },
      "id": "a7000007-0007-4000-8000-000000000005",
      "name": "No Pending Command",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        960,
        400
      ]
    }
  ],
  "connections": {
    "Every 1 Minute": {
      "main": [
        [
          {
            "node": "Process Next Admin Command",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Next Admin Command": {
      "main": [
        [
          {
            "node": "Command Processed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Command Processed?": {
      "main": [
        [
          {
            "node": "Log Result",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Pending Command",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "staticData": null
}
