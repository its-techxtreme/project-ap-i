# ============================================================
# Project AP-I — Environment Variables Example
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# All values here are placeholders only.
# ============================================================

# ============================================================
# VERCEL / WEB APP
# ============================================================

# Supabase — Public (safe for browser bundle)
NEXT_PUBLIC_SUPABASE_URL=REPLACE_ME
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME

# App
APP_BASE_URL=REPLACE_ME
APP_ENV=development

# Supabase — Server-only (NEVER expose to browser, NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# Internal worker token — server-only, used by Vercel server actions to call worker
WORKER_INTERNAL_TOKEN=REPLACE_ME
WORKER_BASE_URL=REPLACE_ME

# Admin web login (username + scrypt hash — NEVER put plaintext password on Vercel)
# Generate hash: node --env-file=.env scripts/hash-admin-password.mjs
ADMIN_USERNAME=REPLACE_ME
ADMIN_PASSWORD_HASH=REPLACE_ME
ADMIN_SESSION_SECRET=REPLACE_ME_MIN_32_CHARS_RANDOM

# Demo dashboard login (read-only — can view /admin, cannot run actions)
# Generate hash: node --env-file=.env scripts/hash-admin-password.mjs
# (set DEMO_PASSWORD in .env temporarily, or pass password as argv)
DEMO_USERNAME=REPLACE_ME
DEMO_PASSWORD_HASH=REPLACE_ME
# One-click "Demo voyage" on /login uses DEMO_USERNAME + DEMO_PASSWORD_HASH only
# (no plaintext password in the browser). Also set these in apps/web/.env.local for local Next.

# ============================================================
# LOCAL WORKER (native or Docker)
# ============================================================

# Supabase
SUPABASE_URL=REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# Worker security
WORKER_INTERNAL_TOKEN=REPLACE_ME
WORKER_PORT=3001

# Google Drive API credentials (OAuth2)
# Setup guide: infra/google-drive/SETUP.md
# Helper: node --env-file=.env scripts/google-drive-auth.mjs
GOOGLE_DRIVE_CLIENT_ID=REPLACE_ME
GOOGLE_DRIVE_CLIENT_SECRET=REPLACE_ME
GOOGLE_DRIVE_REFRESH_TOKEN=REPLACE_ME
# Preferred permanent auth (skips OAuth refresh tokens). Path to SA JSON key.
# Share the three Drive folders with the service account email as Editor.
# GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=C:\secrets\project-api-drive-sa.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=REPLACE_ME
GOOGLE_DRIVE_PROCESSED_FOLDER_ID=REPLACE_ME
GOOGLE_DRIVE_FAILED_FOLDER_ID=REPLACE_ME

# AI Metadata — Gemini primary, Groq fallback (OpenRouter optional)
# Never commit real keys. Local .env only.
GEMINI_API_KEY=REPLACE_ME
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=REPLACE_ME
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Optional tertiary
# OPENROUTER_API_KEY=REPLACE_ME
# OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Legacy NIM vars (unused by new provider)
# AI_PROVIDER_BASE_URL=
# AI_PROVIDER_API_KEY=
# AI_MODEL=

# File paths — Docker uses /app/... ; native worker: set to local paths
# Quiet guitar bed mixed under original audio at 5% volume (see EditPreset)
BACKGROUND_MUSIC_PATH=/app/assets/bgm/absolutesound-background-guitar-no-copyright-561871.mp3
TMP_DIR=/app/tmp/jobs

# Concurrency limits — keep MAX_FFMPEG_CONCURRENCY=1 on typical dev laptops
MAX_FFMPEG_CONCURRENCY=1
MAX_DOWNLOAD_CONCURRENCY=2
MAX_UPLOAD_CONCURRENCY_PER_PLATFORM=1

# Per platform-account successful uploads per rolling 24 hours (YouTube quota protection).
# When reached, jobs stay queued / ready_to_upload instead of retry-looping.
# Window matches platform behavior (~24h after uploads), not UTC midnight.
DAILY_UPLOAD_LIMIT_PER_ACCOUNT=5

# Timing
# Local smoke may temporarily use 1–2; daily use should stay 30
VERIFY_DELAY_MINUTES=5
JOB_LOCK_MINUTES=45
# Recover crash-stuck uploading jobs after this many ms without progress
UPLOAD_STALE_THRESHOLD_MS=1500000
# Hard timeout for one YouTube/Instagram Playwright upload attempt
UPLOAD_PLATFORM_TIMEOUT_MS=720000

# Optional absolute paths when WinGet binaries are not on PATH for detached workers
# YT_DLP_PATH=
# FFMPEG_PATH=
# FFPROBE_PATH=

# Safety flags — MUST be false in development, test, and CI
# Only set to true on local machine during Phase 15 smoke test — never in CI/Vercel
REAL_UPLOADS_ENABLED=false
YOUTUBE_UPLOADS_ENABLED=false
INSTAGRAM_UPLOADS_ENABLED=false

# Playwright uploader behavior (worker only)
# YouTube: log in with real Chrome via `smoke:playwright -- --login --profile memes-yt`
# Uploads use PLAYWRIGHT_CHANNEL=chrome to reuse that same profile (not bundled Chromium)
# Local: PLAYWRIGHT_HEADLESS=false with visible Chrome window
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_CHANNEL=chrome
PLAYWRIGHT_CHROME_PATH=
# Local dev: absolute path to playwright-profiles/ (defaults to repo root if unset)
PLAYWRIGHT_PROFILES_DIR=
PLAYWRIGHT_SLOW_MO_MS=200
PLAYWRIGHT_TYPING_DELAY_MIN_MS=120
PLAYWRIGHT_TYPING_DELAY_MAX_MS=280
PLAYWRIGHT_ACTION_DELAY_MIN_MS=2500
PLAYWRIGHT_ACTION_DELAY_MAX_MS=6000
PLAYWRIGHT_READING_DELAY_MIN_MS=3500
PLAYWRIGHT_READING_DELAY_MAX_MS=9000

# Integration tests — gates real yt-dlp downloads (never true in CI unit tests)
INTEGRATION_TESTS_ENABLED=false

# Source download limits
MAX_SOURCE_DURATION_SECONDS=180
MAX_SOURCE_FILE_SIZE_MB=500

# ============================================================
# n8n (local Docker)
# Setup: infra/n8n/README.md
# Run: pnpm docker:up
# ============================================================

# n8n encryption — set BEFORE creating credentials in n8n UI
# Generate: node scripts/setup-local-env.mjs
N8N_ENCRYPTION_KEY=REPLACE_ME
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Local n8n owner login (for UI + n8n MCP — never commit real values)
N8N_LOGIN_EMAIL=REPLACE_ME
N8N_LOGIN_PASSWORD=REPLACE_ME

# n8n calls to worker
WORKER_BASE_URL=REPLACE_ME
WORKER_INTERNAL_TOKEN=REPLACE_ME

# n8n reads Supabase (for polling workflows)
SUPABASE_URL=REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# Webhook auth for WF-04 / WF-05 (header X-Webhook-Token)
N8N_WEBHOOK_TOKEN=REPLACE_ME

# Optional: create in n8n UI (Settings → API) for scripts/import-n8n-workflows.mjs
N8N_API_KEY=REPLACE_ME
N8N_API_BASE_URL=http://localhost:5678
