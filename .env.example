# ============================================================
# Project AP-I — Environment Variables Example
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# All values here are placeholders only.
# ============================================================

# ============================================================
# VERCEL / WEB APP
# ============================================================

# Supabase — Public (safe for browser bundle)
NEXT_PUBLIC_SUPABASE_URL=REPLACE_ME
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME

# App
APP_BASE_URL=REPLACE_ME
APP_ENV=development

# Supabase — Server-only (NEVER expose to browser, NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# Internal worker token — server-only, used by Vercel server actions to call worker
WORKER_INTERNAL_TOKEN=REPLACE_ME
WORKER_BASE_URL=REPLACE_ME

# ============================================================
# VPS WORKER
# ============================================================

# Supabase
SUPABASE_URL=REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# Worker security
WORKER_INTERNAL_TOKEN=REPLACE_ME
WORKER_PORT=3001

# Google Drive API credentials (OAuth2)
GOOGLE_DRIVE_CLIENT_ID=REPLACE_ME
GOOGLE_DRIVE_CLIENT_SECRET=REPLACE_ME
GOOGLE_DRIVE_REFRESH_TOKEN=REPLACE_ME
GOOGLE_DRIVE_ROOT_FOLDER_ID=REPLACE_ME
GOOGLE_DRIVE_PROCESSED_FOLDER_ID=REPLACE_ME
GOOGLE_DRIVE_FAILED_FOLDER_ID=REPLACE_ME

# AI Metadata generation (OpenAI-compatible provider)
AI_PROVIDER_BASE_URL=REPLACE_ME
AI_PROVIDER_API_KEY=REPLACE_ME
AI_MODEL=REPLACE_ME

# File paths (within Docker container)
WATERMARK_PATH=/app/assets/watermark.png
TMP_DIR=/app/tmp/jobs

# Concurrency limits — do NOT increase MAX_FFMPEG_CONCURRENCY above 1 on MVP VPS
MAX_FFMPEG_CONCURRENCY=1
MAX_DOWNLOAD_CONCURRENCY=2
MAX_UPLOAD_CONCURRENCY_PER_PLATFORM=1

# Timing
VERIFY_DELAY_MINUTES=30
JOB_LOCK_MINUTES=45

# Safety flags — MUST be false in development, test, and CI
# Only set to true in production after controlled smoke test passes
REAL_UPLOADS_ENABLED=false
YOUTUBE_UPLOADS_ENABLED=false
INSTAGRAM_UPLOADS_ENABLED=false

# ============================================================
# n8n (VPS)
# ============================================================

# n8n encryption — set this BEFORE creating any credentials in n8n
N8N_ENCRYPTION_KEY=REPLACE_ME
N8N_HOST=REPLACE_ME
N8N_PROTOCOL=https
WEBHOOK_URL=REPLACE_ME

# n8n calls to worker
WORKER_BASE_URL=REPLACE_ME
WORKER_INTERNAL_TOKEN=REPLACE_ME

# n8n reads Supabase (for polling workflows)
SUPABASE_URL=REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
