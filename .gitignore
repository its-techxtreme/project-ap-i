# Environment and secrets
.env
.env.*
!.env.example

# Local stack PID tracking
.stack-worker.pid
.stack-worker.log
.stack-autostart.log
.stack-autostart.lock

# Dependencies
node_modules/
.pnpm-store/

# Build output
.next/
dist/
build/
out/
.turbo/
*.tsbuildinfo

# Test output
coverage/
playwright-report/
test-results/
.nyc_output/

# Logs
*.log
/logs/
npm-debug.log*
pnpm-debug.log*

# Media files — never commit
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.wmv
*.flv
!apps/worker/tests/fixtures/sample.mp4
!apps/worker/tests/fixtures/watermark.png
!apps/worker/assets/watermark.png
!apps/worker/assets/watermarks/*.png
apps/worker/tests/fixtures/_ffmpeg-test/
