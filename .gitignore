# Sensitive runtime files — never commit
playwright-profiles/
secrets/
tokens/
.drive-cache/
*.sqlite
*.db

# OS files
.DS_Store
Thumbs.db

# Editor / local AI tooling — do not publish agent prompts or editor rules
.idea/
.cursor/
.cursorrules
prompts/
*.swp
*.swo

.vercel
apps/web/.vercel
.env*
.env.local
apps/web/.env.local

