{
  "name": "project-ap-i",
  "version": "0.1.0",
  "private": true,
  "description": "Project AP-I: Short-form content intake, processing, and publishing system",
  "author": "Atharva (Techno)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:db": "pnpm --filter @project-api/worker test:db",
    "test:worker": "pnpm --filter @project-api/worker test",
    "test:web": "pnpm --filter @project-api/web test",
    "test:e2e": "pnpm --filter @project-api/web test:e2e",
    "test:security": "pnpm -r test:security",
    "build": "pnpm -r build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "setup:local-env": "node scripts/setup-local-env.mjs",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d n8n",
    "docker:up:full": "node scripts/docker-up-full.mjs",
    "docker:down": "docker compose -f infra/docker-compose.yml --profile full down",
    "docker:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "stack:up": "node scripts/stack-up.mjs",
    "stack:down": "node scripts/stack-down.mjs",
    "stack:status": "node scripts/stack-status.mjs",
    "stack:autostart": "node scripts/stack-autostart.mjs",
    "stack:autostart:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-stack-autostart.ps1",
    "stack:autostart:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-stack-autostart.ps1",
    "n8n:export": "node --env-file=.env scripts/export-n8n-workflows.mjs",
    "n8n:import": "node scripts/import-n8n-workflows.mjs",
    "n8n:setup": "node scripts/setup-n8n-workflows.mjs",
    "n8n:test": "node scripts/test-n8n-workflows.mjs",
    "n8n:test:all": "node scripts/test-all-n8n-workflows.mjs"
  },
  "devDependencies": {
    "vercel": "^54.21.1"
  }
}
