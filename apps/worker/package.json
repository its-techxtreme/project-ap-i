{
  "name": "@project-api/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:local": "node --env-file=../../.env dist/index.js",
    "lint": "eslint src tests --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:db": "echo 'DB integration tests — requires Supabase' && exit 0",
    "test:worker": "vitest run",
    "test:ffmpeg-integration": "vitest run tests/mediaPipeline.integration.test.ts tests/probeMedia.test.ts",
    "test:drive-integration": "vitest run --config vitest.drive.config.ts",
    "test:metadata-integration": "vitest run --config vitest.metadata.config.ts",
    "test:security": "echo 'TODO Phase 16' && exit 0",
    "smoke": "node --env-file=../../.env scripts/smoke-test.mjs",
    "smoke:playwright": "tsx --env-file=../../.env scripts/smoke-playwright.ts",
    "seed:test-job": "node --env-file=../../.env scripts/seed-test-job.mjs",
    "setup:profiles": "node --env-file=../../.env scripts/set-browser-profile-paths.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@project-api/shared": "workspace:*",
    "@supabase/supabase-js": "^2.98.0",
    "execa": "^9.6.1",
    "fastify": "^5.3.3",
    "googleapis": "^173.0.0",
    "p-limit": "^6.2.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.61.1",
    "ws": "^8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.20.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^9.39.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^3.2.6"
  }
}
